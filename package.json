{
  "name": "streamthing",
  "version": "0.1.1",
  "description": "Compagnon desktop Tauri/Solid pour piloter une sélection Syncthing via .stignore.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "streamthing": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/streamthing.ps1",
    "test:file-tree": "node scripts/smoke-file-tree-utils.mjs",
    "build:cli": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-sidecars.ps1",
    "prepare:sidecars": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-sidecars.ps1",
    "build:desktop": "tauri build --no-bundle --ci",
    "build:desktop:bundle": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-bundle.ps1",
    "package:release": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "benchmark:syncthing-ui": "node pocs/syncthing-ui-watch-benchmark/benchmark.mjs",
    "serve": "vite preview",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-solid": "^0.559.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
