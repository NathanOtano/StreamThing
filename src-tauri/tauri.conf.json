{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamThing",
  "version": "0.1.2",
  "mainBinaryName": "streamthing-desktop",
  "identifier": "io.streamthing.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreamThing",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/streamthing-cli-x86_64-pc-windows-msvc.exe": "streamthing-cli.exe",
      "binaries/streamthing.cmd": "streamthing.cmd"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
